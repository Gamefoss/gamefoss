{
  "name": "gamefoss",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content:sync && astro dev",
    "build": "npm run content:sync && astro build && npm run images:optimize && pagefind --site dist",
    "preview": "astro preview",
    "check": "npm run content:sync && astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "podcast:sync": "tsx scripts/sync-podcast.ts",
    "videos:sync": "tsx scripts/sync-videos.ts",
    "content:sync": "npm run podcast:sync && npm run videos:sync",
    "images:optimize": "tsx scripts/optimize-images.ts",
    "content:migrate": "tsx scripts/migrate-wordpress.ts",
    "validate:links": "tsx scripts/validate-links.ts",
    "validate": "npm run test && npm run check && npm run build && npm run validate:links",
    "release": "standard-version --infile changelog.md"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.8",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^7.3.8",
    "astro-disqus": "^1.0.1",
    "classnames": "^2.5.1",
    "embla-carousel": "^8.6.0",
    "fast-xml-parser": "^5.2.5",
    "media-chrome": "^4.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "sanitize-html": "^2.17.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.7.2",
    "@types/sanitize-html": "^2.16.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "pagefind": "^1.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "standard-version": "^9.5.0",
    "tsx": "^4.20.6",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
