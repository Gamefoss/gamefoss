---
import Logo from './Logo.astro';
import Button from './Button';
import { withBase } from '@/lib/site';
const links = [
  { label: 'Podcast', href: '/podcast/', tracking: 'podcast' },
  { label: 'Blog', href: '/blog/', tracking: 'articles' },
  { label: 'Autores', href: '/autores/', tracking: 'autores' },
  { label: 'Sobre', href: '/sobre/', tracking: 'sobre' },
  { label: 'Contato', href: '/contato/', tracking: 'contato' },
];
---

<header class="site-header">
  <div class="site-header__inner shell">
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      data-ga="navigation-menu-toggle"
    >
      <span class="sr-only">Abrir menu</span>
      <span></span>
      <span></span>
      <span></span>
    </button>
    <Logo />
    <Button
      as="a"
      variant="accent"
      className="site-header__mobile-search"
      href={withBase('/busca/')}
      aria-label="Buscar"
      icon="search"
      iconOnly
      data-ga="search-header-mobile"
    />
    <nav
      id="main-navigation"
      class="site-header__nav"
      aria-label="Navegação principal"
    >
      {links.map(({ label, href, tracking }) => (
        <a href={withBase(href)} data-ga={`navigation-header-${tracking}`}>
          {label}
        </a>
      ))}
      <Button
        as="a"
        variant="accent"
        className="site-header__search"
        href={withBase('/busca/')}
        aria-label="Buscar"
        icon="search"
        data-ga="search-header"
      >
        Buscar
      </Button>
    </nav>
  </div>
  <button
    class="site-header__overlay"
    type="button"
    aria-label="Fechar menu"
    tabindex="-1"
  ></button>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    '.site-header__toggle',
  );
  const nav = document.querySelector<HTMLElement>('.site-header__nav');
  const overlay = document.querySelector<HTMLButtonElement>(
    '.site-header__overlay',
  );
  const label = toggle?.querySelector<HTMLElement>('.sr-only');

  const setMenuOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('site-header__nav--open', open);
    overlay?.classList.toggle('site-header__overlay--open', open);
    document.documentElement.classList.toggle('mobile-menu-open', open);
    if (label) label.textContent = open ? 'Fechar menu' : 'Abrir menu';
  };

  toggle?.addEventListener('click', () =>
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'),
  );
  overlay?.addEventListener('click', () => setMenuOpen(false));
  nav
    ?.querySelectorAll('a')
    .forEach((link) =>
      link.addEventListener('click', () => setMenuOpen(false)),
    );
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });
</script>
