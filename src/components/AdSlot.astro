---
interface Props { format?: 'banner' | 'rectangle'; }
const { format = 'banner' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT;
---
<aside class:list={['ad-slot', `ad-slot--${format}`]} aria-label="Publicidade">
  {client && slot ? <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins> : <span class="ad-slot__placeholder">ESPAÇO PUBLICITÁRIO</span>}
  <span class="ad-slot__label">PUBLICIDADE</span>
</aside>
{client && slot && <script is:inline>try {(adsbygoogle = window.adsbygoogle || []).push({});} catch (e) {}</script>}
