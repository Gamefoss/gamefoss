---
import type { PodcastEpisode } from '@/lib/podcast';
import { getEpisodeArtwork } from '@/lib/podcast';
import { formatDate, withBase } from '@/lib/site';
import Icon from '@/components/Icon';
interface Props {
  episode: PodcastEpisode;
}
const { episode } = Astro.props;
const artwork = getEpisodeArtwork(episode);
---

<article class="episode-card">
  <a
    class="episode-card__art"
    href={withBase(`/podcast/${episode.slug}/`)}
    data-ga="episode-card-artwork"
  >
    <img src={artwork} alt="" loading="lazy" />
    <span class="episode-card__play" aria-hidden="true">
      <Icon name="play" />
    </span>
  </a>
  <div>
    <p class="eyebrow">{formatDate(episode.publishedAt)}</p>
    <h3>
      <a
        href={withBase(`/podcast/${episode.slug}/`)}
        data-ga="episode-card-title"
      >
        {episode.title}
      </a>
    </h3>
    {episode.duration && (
      <span class="episode-card__duration">{episode.duration}</span>
    )}
  </div>
</article>
