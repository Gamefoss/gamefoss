---
import Icon from './Icon';

interface Props {
  label: string;
  className?: string;
  trackClass?: string;
  showArrows?: boolean;
  showDots?: boolean;
  options?: {
    loop?: boolean;
    dragFree?: boolean;
    slidesToScroll?: number | 'auto';
    skipSnaps?: boolean;
    duration?: number;
    startIndex?: number;
  };
}

const {
  label,
  className = '',
  trackClass = '',
  showArrows = false,
  showDots = true,
  options = {},
} = Astro.props;
const showControls = showArrows || showDots;
---

<section
  class:list={['carousel', className]}
  aria-label={label}
  data-carousel
  data-carousel-options={JSON.stringify(options)}
>
  <div class="carousel__viewport" data-carousel-viewport>
    <div class:list={['carousel__track', trackClass]}>
      <slot />
    </div>
  </div>
  {showControls && (
    <div
      class:list={[
        'carousel__controls',
        { 'carousel__controls--arrows-only': showArrows && !showDots },
        { 'carousel__controls--dots-only': showDots && !showArrows },
      ]}
    >
      {showArrows && (
        <button
          class="carousel__button carousel__button--prev"
          type="button"
          aria-label="Item anterior"
          data-carousel-prev
        >
          <Icon name="arrow-left" />
        </button>
      )}
      {showDots && (
        <div
          class="carousel__dots"
          aria-label="Escolher item"
          data-carousel-dots
        />
      )}
      {showArrows && (
        <button
          class="carousel__button carousel__button--next"
          type="button"
          aria-label="Próximo item"
          data-carousel-next
        >
          <Icon name="arrow-right" />
        </button>
      )}
    </div>
  )}
</section>

<script>
  import EmblaCarousel from 'embla-carousel';

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>(
      '[data-carousel-viewport]',
    );
    const previous = root.querySelector<HTMLButtonElement>(
      '[data-carousel-prev]',
    );
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dots = root.querySelector<HTMLElement>('[data-carousel-dots]');
    if (!viewport) return;

    const options = JSON.parse(root.dataset.carouselOptions ?? '{}');

    const mobile = window.matchMedia('(width < 48rem)');
    let carousel: ReturnType<typeof EmblaCarousel> | undefined;

    const mount = () => {
      if (!mobile.matches || carousel) return;
      const firstSlide = viewport.querySelector<HTMLElement>(
        '.carousel__track > *',
      );
      const gutter = firstSlide
        ? firstSlide.getBoundingClientRect().left -
          viewport.getBoundingClientRect().left
        : 0;
      carousel = EmblaCarousel(viewport, {
        align: () => gutter,
        containScroll: 'trimSnaps',
        ...options,
      });
      const dotButtons = dots
        ? carousel.scrollSnapList().map((_, index) => {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'carousel__dot';
            dot.setAttribute('aria-label', `Ir para o item ${index + 1}`);
            dot.addEventListener('click', () => carousel?.scrollTo(index));
            dots.append(dot);
            return dot;
          })
        : [];

      const update = () => {
        if (!carousel) return;
        if (previous) previous.disabled = !carousel.canScrollPrev();
        if (next) next.disabled = !carousel.canScrollNext();
        dotButtons.forEach((dot, index) =>
          dot.setAttribute(
            'aria-current',
            String(index === carousel?.selectedScrollSnap()),
          ),
        );
      };

      if (previous) previous.onclick = () => carousel?.scrollPrev();
      if (next) next.onclick = () => carousel?.scrollNext();
      carousel.on('select', update);
      carousel.on('reInit', update);
      update();
    };

    const sync = () => {
      if (mobile.matches) mount();
      else if (carousel) {
        carousel.destroy();
        carousel = undefined;
        dots?.replaceChildren();
      }
    };

    mobile.addEventListener('change', sync);
    sync();
  });
</script>
