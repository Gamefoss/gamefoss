---
import Icon from './Icon';

interface Props {
  label: string;
  className?: string;
  trackClass?: string;
}

const { label, className = '', trackClass = '' } = Astro.props;
---
<section class:list={['carousel', className]} aria-label={label} data-carousel>
  <div class="carousel__viewport" data-carousel-viewport>
    <div class:list={['carousel__track', trackClass]}>
      <slot />
    </div>
  </div>
  <div class="carousel__controls">
    <button class="carousel__button carousel__button--prev" type="button" aria-label="Item anterior" data-carousel-prev>
      <Icon name="arrow-left" />
    </button>
    <div class="carousel__dots" aria-label="Escolher item" data-carousel-dots></div>
    <button class="carousel__button carousel__button--next" type="button" aria-label="Próximo item" data-carousel-next>
      <Icon name="arrow-right" />
    </button>
  </div>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('[data-carousel-viewport]');
    const previous = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dots = root.querySelector<HTMLElement>('[data-carousel-dots]');
    if (!viewport || !previous || !next || !dots) return;

    const mobile = window.matchMedia('(max-width: 520px)');
    let carousel: ReturnType<typeof EmblaCarousel> | undefined;

    const mount = () => {
      if (!mobile.matches || carousel) return;
      const firstSlide = viewport.querySelector<HTMLElement>('.carousel__track > *');
      const gutter = firstSlide ? firstSlide.getBoundingClientRect().left - viewport.getBoundingClientRect().left : 0;
      carousel = EmblaCarousel(viewport, { align: () => gutter, containScroll: 'trimSnaps' });
      const dotButtons = carousel.scrollSnapList().map((_, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'carousel__dot';
        dot.setAttribute('aria-label', `Ir para o item ${index + 1}`);
        dot.addEventListener('click', () => carousel?.scrollTo(index));
        dots.append(dot);
        return dot;
      });

      const update = () => {
        if (!carousel) return;
        previous.disabled = !carousel.canScrollPrev();
        next.disabled = !carousel.canScrollNext();
        dotButtons.forEach((dot, index) => dot.setAttribute('aria-current', String(index === carousel?.selectedScrollSnap())));
      };

      previous.onclick = () => carousel?.scrollPrev();
      next.onclick = () => carousel?.scrollNext();
      carousel.on('select', update);
      carousel.on('reInit', update);
      update();
    };

    const sync = () => {
      if (mobile.matches) mount();
      else if (carousel) {
        carousel.destroy();
        carousel = undefined;
        dots.replaceChildren();
      }
    };

    mobile.addEventListener('change', sync);
    sync();
  });
</script>
