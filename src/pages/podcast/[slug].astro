---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/AdSlot.astro';
import AudioPlayer from '@/components/AudioPlayer.astro';
import Button from '@/components/Button';
import Share from '@/components/Share';
import episodes from '@generated/episodes.json';
import type { PodcastEpisode } from '@/lib/podcast';
import { getEpisodeArtwork } from '@/lib/podcast';
import { formatDate } from '@/lib/site';
import Icon from '@/components/Icon';
import {
  breadcrumbJsonLd,
  podcastSeriesReference,
  siteUrl,
} from '@/lib/structured-data';

export function getStaticPaths() {
  return (episodes as PodcastEpisode[]).map((episode) => ({
    params: { slug: episode.slug },
    props: { episode },
  }));
}
const { episode } = Astro.props as { episode: PodcastEpisode };
const artwork = getEpisodeArtwork(episode);
const episodeUrl = siteUrl(Astro.site, `/podcast/${episode.slug}/`);
const episodeDescription = episode.description
  .replace(/<[^>]+>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const episodeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  '@id': `${episodeUrl}#podcast-episode`,
  name: episode.title,
  url: episodeUrl,
  image: siteUrl(Astro.site, artwork),
  datePublished: episode.publishedAt,
  description: episodeDescription.slice(0, 300),
  associatedMedia: { '@type': 'MediaObject', contentUrl: episode.audioUrl },
  partOfSeries: podcastSeriesReference(Astro.site),
  inLanguage: 'pt-BR',
};
const jsonLd = [
  episodeJsonLd,
  breadcrumbJsonLd(Astro.site, [
    { name: 'Início', path: '/' },
    { name: 'Podcast', path: '/podcast/' },
    { name: episode.title, path: `/podcast/${episode.slug}/` },
  ]),
];
---

<BaseLayout
  title={episode.title}
  description={episode.description.replace(/<[^>]+>/g, ' ').slice(0, 155)}
  image={artwork}
  imageAlt={`Capa do episódio ${episode.title}`}
  jsonLd={jsonLd}
>
  <header class="page-hero page-hero--article page-hero--episode">
    <div class="page-hero__backdrop" aria-hidden="true">
      <img src={artwork} alt="" data-pagefind-meta="image[src]" />
    </div>
    <div class="page-hero__content shell">
      <p class="eyebrow">
        <span>PODCAST</span>
        <Icon name="dot" />
        <span>{formatDate(episode.publishedAt)}</span>
      </p>
      <h1>{episode.title}</h1>
      {episode.duration && (
        <p class="page-hero__description">Duração: {episode.duration}</p>
      )}
    </div>
  </header>
  <div class="prose" data-pagefind-body data-pagefind-meta="type:Episódio">
    <div class="episode-player">
      <AudioPlayer
        src={episode.audioUrl}
        label={`Ouvir ${episode.title}`}
        className="episode-player__audio"
        analyticsLabel="episode-audio-player"
      />
      <Button
        as="a"
        href={episode.spotifyUrl}
        target="_blank"
        rel="noopener"
        icon="spotify"
        data-ga="episode-spotify"
      >
        Spotify
      </Button>
    </div>
    <div set:html={episode.description} />
    <Share
      client:load
      title={episode.title}
      url={episodeUrl}
      description={episodeDescription}
    />
  </div>
  <AdSlot />
</BaseLayout>
