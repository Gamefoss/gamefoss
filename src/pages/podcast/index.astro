---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import Icon from '@/components/Icon';
import HeroDecoration from '@/components/HeroDecoration.astro';
import episodes from '@generated/episodes.json';
import type { PodcastEpisode } from '@/lib/podcast';
import { PODCAST_LINKS } from '@/lib/site';
import Pagination from '@/components/Pagination.astro';
import Button from '@/components/Button';
import { breadcrumbJsonLd, podcastSeriesJsonLd } from '@/lib/structured-data';
const podcast = episodes as PodcastEpisode[];
const pageSize = 8;
const jsonLd = [
  podcastSeriesJsonLd(Astro.site),
  breadcrumbJsonLd(Astro.site, [
    { name: 'Início', path: '/' },
    { name: 'Podcast', path: '/podcast/' },
  ]),
];
---

<BaseLayout
  title="Podcast"
  description="Todos os episódios do podcast Gamefoss."
  jsonLd={jsonLd}
>
  <header class="page-hero">
    <HeroDecoration icon="headphones" />
    <div class="shell">
      <p class="eyebrow">GAMEFOSS PODCAST</p>
      <h1>
        Ouça. <em>Pense.</em> Jogue.
      </h1>
      <p>
        Conversas sobre jogos, tecnologia, sociedade e o que mais der na telha.
      </p>
      <div class="podcast-platforms">
        <Button
          as="a"
          href={PODCAST_LINKS.spotify}
          target="_blank"
          rel="noopener"
          icon="spotify"
        >
          Spotify
        </Button>
        <Button
          as="a"
          variant="white"
          href={PODCAST_LINKS.apple}
          target="_blank"
          rel="noopener"
          icon="apple"
        >
          Apple Podcasts
        </Button>
        <Button
          as="a"
          variant="white"
          href={PODCAST_LINKS.castbox}
          target="_blank"
          rel="noopener"
          icon="castbox"
        >
          Castbox
        </Button>
        <Button
          as="a"
          variant="white"
          href={PODCAST_LINKS.feed}
          target="_blank"
          rel="noopener"
          icon="rss"
        >
          RSS
        </Button>
      </div>
    </div>
  </header>
  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            ARQUIVO <Icon name="headphones" />
          </p>
          <h2>Episódios</h2>
        </div>
      </div>
      <div class="episode-list">
        {podcast.slice(0, pageSize).map((episode) => (
          <EpisodeCard episode={episode} />
        ))}
      </div>
    </div>
    <Pagination
      current={1}
      last={Math.ceil(podcast.length / pageSize)}
      root="/podcast"
    />
  </section>
</BaseLayout>
