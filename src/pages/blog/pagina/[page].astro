---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Pagination from '@/components/Pagination.astro';
import HeroDecoration from '@/components/HeroDecoration.astro';
import Icon from '@/components/Icon';
import { breadcrumbJsonLd } from '@/lib/structured-data';
export const getStaticPaths = (async ({ paginate }) => {
  const articles = (
    await getCollection('articles', ({ data }) => !data.draft)
  ).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
  return paginate(articles, { pageSize: 6 });
}) satisfies GetStaticPaths;
interface Props {
  page: Page<CollectionEntry<'articles'>>;
}
const { page } = Astro.props;
const jsonLd = breadcrumbJsonLd(Astro.site, [
  { name: 'Início', path: '/' },
  { name: 'Blog', path: '/blog/' },
  {
    name: `Página ${page.currentPage}`,
    path: `/blog/pagina/${page.currentPage}/`,
  },
]);
---

<BaseLayout title={`Blog — página ${page.currentPage}`} jsonLd={jsonLd}>
  <header class="page-hero">
    <HeroDecoration icon="newspaper" />
    <div class="shell">
      <p class="eyebrow">
        <span>ARQUIVO</span>
        <Icon name="minus" />
        <span>PÁGINA {page.currentPage}</span>
      </p>
      <h1>Blog</h1>
    </div>
  </header>
  <section class="section section--paper">
    <div class="article-grid shell">
      {page.data.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
    <Pagination current={page.currentPage} last={page.lastPage} root="/blog" />
  </section>
</BaseLayout>
