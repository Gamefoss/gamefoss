---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { slugify, withBase } from '@/lib/site';
import Button from '@/components/Button';
import { breadcrumbJsonLd } from '@/lib/structured-data';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const tags = new Map<string, string>();
  for (const tag of articles.flatMap((article) => article.data.tags)) {
    const slug = slugify(tag);
    const existing = tags.get(slug);
    if (existing && existing !== tag)
      throw new Error(
        `Tag slug collision: "${existing}" and "${tag}" both resolve to "${slug}".`,
      );
    tags.set(slug, tag);
  }
  return [...tags].map(([slug, tag]) => ({
    params: { slug },
    props: {
      tag,
      articles: articles.filter((article) => article.data.tags.includes(tag)),
    },
  }));
}

const { tag, articles } = Astro.props;
const tagSlug = slugify(tag);
const jsonLd = breadcrumbJsonLd(Astro.site, [
  { name: 'Início', path: '/' },
  { name: 'Tags', path: '/tags/' },
  { name: tag, path: `/tag/${tagSlug}/` },
]);
---

<BaseLayout
  title={tag}
  description={`Artigos do Gamefoss sobre ${tag}.`}
  jsonLd={jsonLd}
>
  <header class="page-hero" data-pagefind-body data-pagefind-meta="type:Tag">
    <div class="shell">
      <Button
        as="a"
        variant="accent"
        className="taxonomy-back"
        href={withBase('/tags/')}
        icon="arrow-left"
      >
        Tags
      </Button>
      <p class="eyebrow">TAG</p>
      <h1>{tag}</h1>
    </div>
  </header>
  <section class="section section--paper">
    <div class="article-grid shell">
      {articles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>
</BaseLayout>
