---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/AdSlot.astro';
import Share from '@/components/Share';
import { formatDate, slugify, withBase } from '@/lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const author = (await getCollection('authors')).find(
  (item) => item.id === article.data.author,
);
const category = await getEntry(article.data.category);
const articleUrl = new URL(withBase(`/artigos/${article.id}/`), Astro.site)
  .href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: (
    article.data.updatedAt || article.data.publishedAt
  ).toISOString(),
  author: { '@type': 'Person', name: author?.data.name || article.data.author },
  mainEntityOfPage: articleUrl,
};
---

<BaseLayout
  title={article.data.seoTitle || article.data.title}
  description={article.data.seoDescription || article.data.description}
  image={article.data.cover}
  type="article"
  jsonLd={jsonLd}
>
  <header class="page-hero page-hero--article">
    {article.data.cover && (
      <div class="page-hero__backdrop" aria-hidden="true">
        <img
          src={withBase(article.data.cover)}
          alt=""
          data-pagefind-meta="image[src]"
        />
      </div>
    )}
    <div class="page-hero__content shell">
      <p class="eyebrow">
        <a
          href={withBase(`/categoria/${category.id}/`)}
          data-ga="article-category"
        >
          {category.data.name}
        </a>
      </p>
      <h1>{article.data.title}</h1>
      <p class="page-hero__description">{article.data.description}</p>
      <div class="prose__meta">
        <div class="prose__byline">
          <span>Por</span>
          <a
            class="prose__author"
            href={author ? withBase(`/autores/${author.id}/`) : '#'}
            data-ga="article-author"
          >
            {author?.data.portrait && (
              <img src={withBase(author.data.portrait)} alt="" />
            )}
            {author?.data.name || article.data.author}
          </a>
        </div>
        <time datetime={article.data.publishedAt.toISOString()}>
          {formatDate(article.data.publishedAt)}
        </time>
      </div>
      {article.data.tags.length > 0 && (
        <nav class="article-tags" aria-label="Tags do artigo">
          <span>Tags</span>
          {article.data.tags.map((tag) => (
            <a
              class="chip"
              href={withBase(`/tag/${slugify(tag)}/`)}
              data-ga="article-tag"
            >
              {tag}
            </a>
          ))}
        </nav>
      )}
    </div>
  </header>
  <article class="prose" data-pagefind-body data-pagefind-meta="type:Artigo">
    <Content />
    <Share
      client:load
      title={article.data.title}
      url={articleUrl}
      description={article.data.description}
    />
  </article>
  <AdSlot />
</BaseLayout>
