---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button';
import HeroDecoration from '@/components/HeroDecoration.astro';
import { SITE_SOCIALS } from '@/lib/site';
import Socials from '@/components/Socials.astro';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'contato@gamefoss.com.br';
---

<BaseLayout title="Contato">
  <header class="page-hero">
    <HeroDecoration icon="email" />
    <div class="shell">
      <p class="eyebrow">CONTINUE A CONVERSA</p>
      <h1>Contato</h1>
      <p>
        Pautas, sugestões, parcerias ou só um “oi”: nossa caixa de entrada está
        aberta.
      </p>
    </div>
  </header>
  <article class="prose">
    <h2>Envie uma mensagem</h2>
    <p>
      Escreva para <a href={`mailto:${email}`}>{email}</a>.
    </p>
    <p>
      <Button
        as="a"
        variant="accent"
        icon="email"
        href={`mailto:${email}?subject=Contato pelo site Gamefoss`}
      >
        E-mail
      </Button>
    </p>
    <h2>Outros canais</h2>
    <p>Você também pode nos encontrar em outras plataformas.</p>
    <Socials
      socials={SITE_SOCIALS}
      owner="Gamefoss"
      className="contact-channels"
      showLabel
    />
  </article>
</BaseLayout>
