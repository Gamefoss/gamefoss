---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'contato@gamefoss.com.br';
---
<BaseLayout title="Contato">
  <header class="page-hero"><div class="shell"><p class="eyebrow">CONTINUE A CONVERSA</p><h1>Contato</h1><p>Pautas, sugestões, parcerias ou só um “oi”: nossa caixa de entrada está aberta.</p></div></header>
  <article class="prose">
    <h2>Envie uma mensagem</h2>
    <p>Escreva para <a href={`mailto:${email}`}>{email}</a>.</p>
    <p><Button as="a" variant="accent" icon="email" href={`mailto:${email}?subject=Contato pelo site Gamefoss`}>E-mail</Button></p>
    <h2>Outros canais</h2>
    <div class="contact-channels">
      <Button as="a" variant="accent" icon="instagram" href="https://www.instagram.com/game_foss/" target="_blank" rel="noopener">Instagram</Button>
      <Button as="a" variant="accent" icon="spotify" href="https://open.spotify.com/show/7es718XuZbCWSm6D0cErsi" target="_blank" rel="noopener">Spotify</Button>
      <Button as="a" variant="accent" icon="youtube" href="https://www.youtube.com/channel/UC-56xFSGCZva048yeG-wFTw" target="_blank" rel="noopener">YouTube</Button>
    </div>
  </article>
</BaseLayout>
