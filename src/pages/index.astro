---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import AdSlot from '@/components/AdSlot.astro';
import episodes from '@generated/episodes.json';
import type { PodcastEpisode } from '@/lib/podcast';
import { sanitizeEpisodeHtml } from '@/lib/podcast';
import { SPOTIFY_SHOW, withBase } from '@/lib/site';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const podcast = episodes as PodcastEpisode[];
const latest = podcast[0];
const excerpt = latest ? sanitizeEpisodeHtml(latest.description).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 260) : '';
---
<BaseLayout>
  <section class="hero"><div class="hero__inner shell">
    <p class="eyebrow">APERTE START PARA CONTINUAR</p>
    <h1>JOGOS.<em>IDEIAS.</em>CULTURA.</h1>
    <div class="hero__meta"><p>Um podcast e uma revista independente sobre os games que jogamos e o mundo que construímos ao redor deles.</p><span class="hero__pixel">EST. 2016 · BRASIL</span></div>
  </div></section>

  {latest && <section class="section"><div class="latest-episode shell">
    <div class="latest-episode__art">{latest.artwork && <img src={latest.artwork} alt={`Capa do episódio ${latest.title}`} />}</div>
    <div class="latest-episode__content">
      <p class="eyebrow">▶ NOVO EPISÓDIO</p><h2>{latest.title}</h2><p>{excerpt}…</p>
      <audio controls preload="none" src={latest.audioUrl}>Seu navegador não suporta áudio.</audio>
      <div class="latest-episode__actions"><a class="button" href={withBase(`/podcast/${latest.slug}/`)}>Detalhes do episódio</a><a class="button button--ghost" href={SPOTIFY_SHOW} target="_blank" rel="noopener">Ouvir no Spotify ↗</a></div>
    </div>
  </div></section>}

  <AdSlot />
  <section class="section section--paper"><div class="shell">
    <div class="section-heading"><div><p class="eyebrow">LEIA, REFLITA, RESPAWN</p><h2>Artigos</h2></div><a href={withBase('/artigos/')}>VER TODOS →</a></div>
    <div class="article-grid">{articles.slice(0,5).map((article, index) => <ArticleCard article={article} featured={index === 0} />)}</div>
  </div></section>
  <section class="section"><div class="shell">
    <div class="section-heading"><div><p class="eyebrow">NO SEU FONE</p><h2>Mais episódios</h2></div><a href={withBase('/podcast/')}>VER TODOS →</a></div>
    <div class="episode-list">{podcast.slice(1,5).map((episode) => <EpisodeCard episode={episode} />)}</div>
  </div></section>
</BaseLayout>
