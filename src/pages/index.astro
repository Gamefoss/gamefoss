---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import FeaturedEpisode from '@/components/FeaturedEpisode.astro';
import AdSlot from '@/components/AdSlot.astro';
import episodes from '@generated/episodes.json';
import type { PodcastEpisode } from '@/lib/podcast';
import { withBase } from '@/lib/site';
import Icon from '@/components/Icon';
import Button from '@/components/Button';
import Carousel from '@/components/Carousel.astro';
import { organizationJsonLd, websiteJsonLd } from '@/lib/structured-data';
import VideoCard from '@/components/VideoCard.astro';
import videos from '@generated/videos.json';
import type { YouTubeVideo } from '@/lib/videos';

const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => {
  if (a.data.featured !== b.data.featured)
    return Number(b.data.featured) - Number(a.data.featured);
  return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
});
const podcast = episodes as PodcastEpisode[];
const latest = podcast[0];
const latestVideos = (videos as YouTubeVideo[]).slice(0, 3);
const jsonLd = [organizationJsonLd(Astro.site), websiteJsonLd(Astro.site)];
---

<BaseLayout jsonLd={jsonLd}>
  {latest && (
    <section class="section">
      <div class="featured-podcast shell">
        <FeaturedEpisode episode={latest} />
        <aside class="featured-podcast__more">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                NO SEU FONE <Icon name="headphones" />
              </p>
              <h2>Episódios</h2>
            </div>
          </div>
          <div class="episode-list episode-list--compact">
            {podcast.slice(1, 3).map((episode) => (
              <EpisodeCard episode={episode} />
            ))}
          </div>
          <div class="featured-podcast__more-action">
            <Button
              as="a"
              variant="accent"
              href={withBase('/podcast/')}
              icon="arrow-right"
              iconPosition="right"
            >
              Ver todos
            </Button>
          </div>
        </aside>
      </div>
    </section>
  )}
  <section class="section section--paper">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span>LEIA, REFLITA & CONSTRUA</span>
            <Icon name="lightbulb" />
          </p>
          <h2>Blog</h2>
        </div>
        <Button
          as="a"
          variant="accent"
          compact
          href={withBase('/blog/')}
          icon="arrow-right"
          iconPosition="right"
        >
          Ver todos
        </Button>
      </div>
      <Carousel
        label="Destaques do blog"
        className="article-carousel"
        trackClass="article-grid article-grid--home"
      >
        {articles.slice(0, 6).map((article, index) => (
          <ArticleCard
            article={article}
            featured={article.data.featured}
            hero={index === 0}
          />
        ))}
      </Carousel>
    </div>
  </section>
  {latestVideos.length > 0 && (
    <section class="section section--blue">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              <span>Gamefoss no Youtube</span>
              <Icon name="youtube" />
            </p>
            <h2>Vídeos</h2>
          </div>
          <Button
            as="a"
            variant="accent"
            compact
            href={withBase('/videos/')}
            icon="arrow-right"
            iconPosition="right"
          >
            Ver todos
          </Button>
        </div>
        <Carousel
          label="Vídeos mais recentes"
          className="video-carousel"
          trackClass="video-grid"
        >
          {latestVideos.map((video) => (
            <VideoCard video={video} />
          ))}
        </Carousel>
      </div>
    </section>
  )}
  <AdSlot />
</BaseLayout>
