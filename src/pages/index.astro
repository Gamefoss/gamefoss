---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import FeaturedEpisode from '@/components/FeaturedEpisode.astro';
import AdSlot from '@/components/AdSlot.astro';
import episodes from '@generated/episodes.json';
import type { PodcastEpisode } from '@/lib/podcast';
import { withBase } from '@/lib/site';
import Icon from '@/components/Icon';
import Button from '@/components/Button';
import Carousel from '@/components/Carousel.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const podcast = episodes as PodcastEpisode[];
const latest = podcast[0];
---
<BaseLayout>
  {latest && <section class="section"><div class="featured-podcast shell"><FeaturedEpisode episode={latest} /><aside class="featured-podcast__more"><div class="section-heading"><div><p class="eyebrow">NO SEU FONE <Icon name="headphones" /></p><h2>Episódios</h2></div></div><div class="episode-list episode-list--compact">{podcast.slice(1,3).map((episode) => <EpisodeCard episode={episode} />)}</div><div class="featured-podcast__more-action"><Button as="a" variant="accent" href={withBase('/podcast/')} icon="arrow-right" iconPosition="right">Ver todos</Button></div></aside></div></section>}

  <section class="section section--paper"><div class="shell">
    <div class="section-heading"><div><p class="eyebrow">LEIA, REFLITA & CONSTRUA</p><h2>Artigos</h2></div><a class="link-with-icon" href={withBase('/artigos/')}>VER TODOS <Icon name="arrow-right" /></a></div>
    <Carousel label="Artigos em destaque" className="article-carousel" trackClass="article-grid article-grid--home">{articles.slice(0,6).map((article, index) => <ArticleCard article={article} featured={index === 0} />)}</Carousel>
  </div></section>
  <AdSlot />
</BaseLayout>
