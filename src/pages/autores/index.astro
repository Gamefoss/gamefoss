---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Carousel from '@/components/Carousel.astro';
import { Icon } from '@/components/Icon/Icon';
import HeroDecoration from '@/components/HeroDecoration.astro';
import { withBase } from '@/lib/site';
import { breadcrumbJsonLd } from '@/lib/structured-data';
import { Button, type ButtonProps } from '@/components/Button/Button';
const authors = await getCollection('authors');
const jsonLd = breadcrumbJsonLd(Astro.site, [
  { name: 'Início', path: '/' },
  { name: 'Autores', path: '/autores/' },
]);
---

<BaseLayout title="Autores" jsonLd={jsonLd}>
  <header class="page-hero">
    <HeroDecoration icon="users" />
    <div class="shell">
      <p class="eyebrow">ESCOLHA SEU PLAYER</p>
      <h1>Autores</h1>
      <p>
        Conheça as pessoas por trás dos controles, microfones e textos do
        Gamefoss.
      </p>
    </div>
  </header>
  <section class="section character-select-section">
    <div class="character-select shell">
      <div class="character-select__screen" aria-hidden="true">
        <span>AUTORES</span>
        <strong>{String(authors.length).padStart(2, '0')}</strong>
      </div>
      <Carousel
        label="Selecionar autor"
        className="character-carousel"
        trackClass="character-select__grid"
        showArrows
        options={{
          loop: true,
        }}
      >
        {authors.map((author, index) => (
          <div class="character-card" style={`--player-index: ${index + 1}`}>
            <span class="character-card__number" aria-hidden>
              P{index + 1}
            </span>
            <div class="character-card__portrait">
              <a href={withBase(`/autores/${author.id}/`)}>
                {author.data.portrait ? (
                  <img
                    src={withBase(author.data.portrait)}
                    alt={
                      author.data.portraitAlt ||
                      `Retrato de ${author.data.name}`
                    }
                  />
                ) : (
                  <span>{author.data.name.slice(0, 1)}</span>
                )}
              </a>
            </div>
            <div class="character-card__info">
              <span class="character-card__info__eyebrow" aria-hidden>
                {['READY!', 'SET!', 'GO!'][index % 3]}
              </span>
              <h2>
                <a href={withBase(`/autores/${author.id}/`)}>
                  {author.data.name}
                </a>
              </h2>
              <p>
                <a href={withBase(`/autores/${author.id}/`)}>
                  {author.data.bio}
                </a>
              </p>
              <Button
                as="a"
                href={withBase(`/autores/${author.id}/`)}
                variant="accent"
                className="character-card__select"
                icon={
                  ['heart', 'star', 'gamepad'][index % 3] as ButtonProps['icon']
                }
                iconPosition="right"
              >
                Selecionar
              </Button>
            </div>
          </div>
        ))}
      </Carousel>
    </div>
  </section>
</BaseLayout>
