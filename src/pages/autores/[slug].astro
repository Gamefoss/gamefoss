---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Socials from '@/components/Socials.astro';
import { withBase } from '@/lib/site';
import { breadcrumbJsonLd, siteUrl } from '@/lib/structured-data';
export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author },
  }));
}
const { author } = Astro.props;
const articles = (
  await getCollection(
    'articles',
    ({ data }) => !data.draft && data.author === author.id,
  )
).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
const authorUrl = siteUrl(Astro.site, `/autores/${author.id}/`);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${authorUrl}#person`,
    name: author.data.name,
    url: authorUrl,
    description: author.data.bio,
    ...(author.data.portrait && {
      image: siteUrl(Astro.site, author.data.portrait),
    }),
    sameAs: Object.values(author.data.socials || {}),
  },
  breadcrumbJsonLd(Astro.site, [
    { name: 'Início', path: '/' },
    { name: 'Autores', path: '/autores/' },
    { name: author.data.name, path: `/autores/${author.id}/` },
  ]),
];
---

<BaseLayout
  title={author.data.name}
  description={author.data.bio}
  jsonLd={jsonLd}
>
  <header
    class="page-hero page-hero--author"
    data-pagefind-body
    data-pagefind-meta="type:Autor"
  >
    <div class="author-profile shell">
      {author.data.portrait && (
        <img
          class="author-profile__portrait"
          src={withBase(author.data.portrait)}
          alt={author.data.portraitAlt || `Retrato de ${author.data.name}`}
          data-pagefind-meta="image[src], image_alt[alt]"
        />
      )}
      <div class="author-profile__content">
        <div class="author-profile__heading">
          <p class="eyebrow">PLAYER PROFILE</p>
          <h1>{author.data.name}</h1>
        </div>
        <p class="author-profile__bio">{author.data.bio}</p>
        <Socials
          socials={author.data.socials || {}}
          owner={author.data.name}
          className="author-profile__socials"
          gaPrefix="author-social"
        />
      </div>
    </div>
  </header>
  <section class="section section--paper">
    <div class="article-grid shell">
      {articles.map((article) => (
        <ArticleCard article={article} showAuthor={false} />
      ))}
    </div>
  </section>
</BaseLayout>
