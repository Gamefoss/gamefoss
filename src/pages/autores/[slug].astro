---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
export async function getStaticPaths() { const authors = await getCollection('authors'); return authors.map((author) => ({ params: { slug: author.id }, props: { author } })); }
const { author } = Astro.props;
const articles = (await getCollection('articles', ({data}) => !data.draft && data.author === author.id)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title={author.data.name} description={author.data.bio}><header class="page-hero" data-pagefind-body><div class="shell"><p class="eyebrow">AUTOR</p><h1>{author.data.name}</h1><p>{author.data.bio}</p></div></header><section class="section section--paper"><div class="article-grid shell">{articles.map((article) => <ArticleCard article={article} />)}</div></section></BaseLayout>
