---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { slugify } from '@/lib/site';
export async function getStaticPaths() {
  const articles = await getCollection('articles', ({data}) => !data.draft);
  const categories = [...new Set(articles.flatMap((a) => a.data.categories))];
  return categories.map((category) => ({ params: { slug: slugify(category) }, props: { category, articles: articles.filter((a) => a.data.categories.includes(category)) } }));
}
const { category, articles } = Astro.props;
---
<BaseLayout title={category}><header class="page-hero" data-pagefind-body><div class="shell"><p class="eyebrow">CATEGORIA</p><h1>{category}</h1></div></header><section class="section section--paper"><div class="article-grid shell">{articles.map((article) => <ArticleCard article={article} />)}</div></section></BaseLayout>
