---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button';
import HeroDecoration from '@/components/HeroDecoration.astro';
import Icon from '@/components/Icon';
import Pagination from '@/components/Pagination.astro';
import VideoCard from '@/components/VideoCard.astro';
import { SITE_SOCIALS } from '@/lib/site';
import { breadcrumbJsonLd } from '@/lib/structured-data';
import type { YouTubeVideo } from '@/lib/videos';
import videos from '@generated/videos.json';

const archive = videos as YouTubeVideo[];
const pageSize = 6;
const jsonLd = breadcrumbJsonLd(Astro.site, [
  { name: 'Início', path: '/' },
  { name: 'Vídeos', path: '/videos/' },
]);
---

<BaseLayout
  title="Vídeos"
  description="Vídeos do Gamefoss sobre jogos, tecnologia, cultura e sociedade."
  jsonLd={jsonLd}
>
  <header class="page-hero">
    <HeroDecoration icon="youtube" />
    <div class="shell">
      <p class="eyebrow">GAMEFOSS NO YOUTUBE</p>
      <h1>
        Assista. <em>Pense.</em> Jogue.
      </h1>
      <p>
        Ensaios, conversas e ideias sobre jogos, tecnologia, cultura e as
        pessoas por trás de tudo isso.
      </p>
      <div class="page-hero__actions">
        <Button
          as="a"
          href={SITE_SOCIALS.youtube}
          target="_blank"
          rel="noopener"
          icon="youtube"
          data-ga="videos-youtube-channel"
        >
          Youtube
        </Button>
      </div>
    </div>
  </header>
  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            ARQUIVO <Icon name="youtube" />
          </p>
          <h2>Nossos Vídeos</h2>
        </div>
      </div>
      <div class="video-grid">
        {archive.slice(0, pageSize).map((video) => (
          <VideoCard video={video} />
        ))}
      </div>
    </div>
    <Pagination
      current={1}
      last={Math.ceil(archive.length / pageSize)}
      root="/videos"
    />
  </section>
</BaseLayout>
